title                   = Final stage of peptide–bilayer system NPT equilibration
; Run parameters
integrator              = md          ; leap-frog integrator
nsteps                  = 10000000    ; 2 * 10000000 = 20000 ps (20 ns)
dt                      = 0.002       ; 2 fs
define                  = -DPOSRES_END -DPOSRES_FC_END=200.0  
; Output control
nstenergy               = 5000      ; save energies every 10.0 ps
nstlog                  = 5000      ; update log file every 10.0 ps
nstxout-compressed      = 5000      ; save coordinates every 10.0 ps
; Bond parameters
continuation            = yes       ; continuing from previous stage
constraint_algorithm    = lincs     ; holonomic constraints 
constraints             = h-bonds   ; bonds involving H are constrained
lincs_iter              = 1         ; accuracy of LINCS
lincs_order             = 4         ; also related to accuracy
; Neighbor searching and vdW
cutoff-scheme           = Verlet
ns_type                 = grid      ; search neighboring grid cells
nstlist                 = 20        ; largely irrelevant with Verlet
rlist                   = 1.4
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2       ; short-range van der Waals cutoff (in nm)
; Electrostatics
coulombtype             = PME       ; Particle Mesh Ewald for long-range electrostatics
rcoulomb                = 1.2       ; short-range electrostatic cutoff (in nm)
pme_order               = 4         ; cubic interpolation
fourierspacing          = 0.12      ; grid spacing for FFT
; Temperature coupling is on
tcoupl                  = V-rescale                    ; modified Berendsen thermostat
tc-grps                 = System
tau_t                   = 0.5                       ; time constant, in ps
ref_t                   = 323                       ; reference temperature for each group, in K
; Pressure coupling 
pcoupl                  = C-rescale                ; robust barostat for NPT
pcoupltype              = semiisotropic            ; apply separate scaling for XY vs Z
tau_p                   = 2.0                      ; barostat time constant
ref_p                   = 1.0   1.0                ; target pressures (XY, Z)
compressibility         = 4.5e-5   4.5e-5           
refcoord_scaling        = com                      ; scale reference coords for restraints
; Periodic boundary conditions
pbc                     = xyz       ; 3-D PBC
; Velocity generation
gen_vel                 = no        ; Velocity generation is off
